# Copy this file to the protected runtime directory described in README.md.
# Required: your isolated assessment CRM token.
CRM_API_TOKEN=replace-with-your-assessment-token

# Optional overrides. The defaults already point at the assessment sandbox.
CRM_API_BASE=https://analyst-assessment-production.up.railway.app/api/v1
CRM_ALLOWED_HOSTS=analyst-assessment-production.up.railway.app
BELLHAVEN_WEBSITE_BASE=https://analyst-assessment-production.up.railway.app
REVIEW_API_PORT=3100
REVIEW_WEB_PORT=3000
REVIEWER_ID=local-reviewer

# For a persistent server, set REVIEW_STATE_PATH to protected non-synced storage.
# REVIEW_STATE_PATH=/var/lib/bellhaven-ownership-review/review-state.json
